# App
ENV=development
DEV_ALLOW_NO_KEYS=0

# Admin
ADMIN_API_KEY=your_admin_api_key_here

# API / local integration
BACKEND_URL=http://127.0.0.1:8000

# Processing
BATCH_SIZE=100
MAX_RETRIES=3

# Auth
AUTH_JWT_SECRET=your_jwt_secret_here
AUTH_ACCESS_TOKEN_MINUTES=30
AUTH_REFRESH_TOKEN_DAYS=14
AUTH_ISSUER=entscheid
AUTH_AUDIENCE=entscheid-web
AUTH_PEPPER=
AUTH_ALLOW_REGISTER=true